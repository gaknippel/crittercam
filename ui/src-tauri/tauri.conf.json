{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "crittercam",
  "version": "0.3.0",
  "identifier": "com.crittercam.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "crittercam",
        "width": 980,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../bin/x64/Release/crittercam.dll": "crittercam.dll"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5MUZBOTkxNkVCNkNDQzMKUldURHpMWnVrYWtmaWVZU2xTbnUzR2xGQTBxUUZUaEx1Mk1NcFRPWTMyRnIrQkdpQUd3MzZHSlcK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}